# Select `strands` only where a configured Bedrock runtime is intended. CLEARFRAME_AGENT_PROVIDER=local AWS_REGION=us-east-1 CLEARFRAME_BEDROCK_MODEL_ID=your-bedrock-model-id # Optional named AWS credential profile; leave blank to use the default AWS credential chain. CLEARFRAME_AWS_PROFILE= # Optional session label for your own runtime/session management. CLEARFRAME_AWS_SESSION_NAME=  # Local frontend-to-backend API NEXT_PUBLIC_CLEARFRAME_API_URL=http://localhost:8000 CLEARFRAME_API_PORT=8000 CLEARFRAME_CORS_ORIGIN=http://localhost:3000